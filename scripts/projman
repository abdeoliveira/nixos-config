#!/usr/bin/env python3
"""projman — a tiny colourful TUI to track research projects by maturity.

Stages (maturity), set with the digit keys:
  0 hold · 1 wait · 2 design · 3 run · 4 draft · 5 my review
  6 team review · 7 submitted · 8 resubmitted · 9 finished
  (design = preparation: literature review, choosing the focus, designing the simulations;
   finished = done for good, published or not: hidden from the list until p shows it)
Trash has no digit: d trashes (hidden; deleted for good after $PROJMAN_TRASH_MONTHS months,
default 3), t shows the trash.

Data lives in ~/.projman.json (override with $PROJMAN_FILE). Stages are stored by name
("stage", and "prev" = stage before trashing), so the numbering can change freely; entries
from the old numbered format ("rank" 0-8, before "design" existed) are converted on load.
Each project also carries a "claude" field: a one-line status written only by
Claude Code (via ~/.claude/bin/projman_claude.py), shown read-only in the
detail box of the selected project. projman never edits it and re-reads it from disk on save.

Layout: the list shows # STAGE PROJECT TEAM (before PROJECT: • a job is running, ◦ its expected
end has passed without confirmation; the "job" field is also written only by Claude Code); the detail box (right of the list, or below it
on narrow terminals) shows the selected project: stage and last modified, TEAM, PATH (as
~/..., blank when unset), OBS in full and the Claude status.

Enter edits the selected project (form). p shows/hides finished projects.
A on a finished project archives it: projman-archive copies PATH to the external HD and to
a restic snapshot, checks both, and deletes the local folder after you type its name. PATH
then points at the HD copy and the project is locked as finished. A again restores it.
Navigation (rows with a PATH that exists on this machine):
  g      go: projman exits and the shell lands in PATH (needs the bash wrapper
         function `projman`, which sets $PROJMAN_CDFILE and cd's afterwards)
  o      open a new terminal in PATH (projman stays open)
  c      open two terminals in PATH, one running `claude --continue` (or a fresh `claude`)
         and a plain one beside it, then close projman and its terminal (the bash
         wrapper exits its shell; without the wrapper only projman quits)
  C      same, but `claude --resume`: pick which past session to resume
The wrapper protocol: projman writes "cd <dir>" or "exit" into $PROJMAN_CDFILE.
Terminal: $PROJMAN_TERMINAL, default alacritty (needs --working-directory and -e).
Pure standard library (curses). Run:  python3 projman.py
"""
import curses
import datetime
import json
import locale
import os
import sys
import shutil
import subprocess
import tempfile
import time
import textwrap
import unicodedata
import uuid

os.environ.setdefault("ESCDELAY", "25")

DATA_FILE = os.environ.get("PROJMAN_FILE", os.path.expanduser("~/.projman.json"))

# (name, 256-colour fg, 8-colour fallback)
STAGES = [  # grey = parked; cyan, white, green->orange = ball with me; blue/violet = ball elsewhere
    ("hold",         244, curses.COLOR_WHITE),
    ("wait",          69, curses.COLOR_BLUE),
    ("design",       123, curses.COLOR_CYAN),
    ("run",          231, curses.COLOR_WHITE),
    ("draft",        112, curses.COLOR_GREEN),
    ("my review",    220, curses.COLOR_YELLOW),
    ("team review",  208, curses.COLOR_YELLOW),
    ("submitted",     99, curses.COLOR_MAGENTA),
    ("resubmitted",  171, curses.COLOR_MAGENTA),
    ("finished",      72, curses.COLOR_GREEN),
]
N = len(STAGES)          # stages are numbered 0 .. N-1 (the digit keys)
FINISHED = N - 1
TRASH = -1               # in-memory marker for trash (no digit, no place on the scale)
STAGE_NO = {name: i for i, (name, _, _) in enumerate(STAGES)}
STAGE_NO["trash"] = TRASH
# earlier stage names -> current ones (files saved before the renaming)
RENAMED = {"waiting": "wait", "running": "run"}
# the numbered format used before "design" was added: rank -> stage name
LEGACY_RANKS = ["trash", "hold", "waiting", "running", "draft", "my review",
                "team review", "submitted", "resubmitted"]
# trash: hidden from the main list, purged automatically after N months
TRASH_MONTHS = max(1, int(os.environ.get("PROJMAN_TRASH_MONTHS", "3") or 3))
TRASH_DAYS = TRASH_MONTHS * 30


def sname(r):
    return "trash" if r == TRASH else STAGES[r][0]


def blabel(r):
    """Text of a stage badge: the digit, or × for trash."""
    return "×" if r == TRASH else str(r)


def stage_of(name, legacy, default):
    """Stage number from a stored stage name, else from a legacy rank number, else default."""
    if isinstance(name, str) and RENAMED.get(name, name) in STAGE_NO:
        return STAGE_NO[RENAMED.get(name, name)]
    try:
        n = LEGACY_RANKS[int(legacy)]
        return STAGE_NO[RENAMED.get(n, n)]
    except (TypeError, ValueError, IndexError):
        return default
SEL_BG = 237  # background of the selected row (256-colour terminals)


# ---------------------------------------------------------------- storage
IDS_ADDED = False   # set by load() when it had to assign ids (they are saved at startup)


def new_id():
    return uuid.uuid4().hex[:8]


def job_field(j):
    """Normalise the Claude-owned "job" field: {"what": str, "until": "YYYY-MM-DDTHH:MM"} or None."""
    if isinstance(j, dict) and j.get("what"):
        return {"what": str(j["what"]), "until": str(j.get("until", ""))}
    return None


def job_state(it):
    """None (no job), "run" (expected end still ahead) or "due" (expected end passed, unconfirmed)."""
    j = it.get("job")
    if not j:
        return None
    try:
        end = datetime.datetime.fromisoformat(j["until"])
    except (ValueError, TypeError):
        return "run"
    return "run" if datetime.datetime.now() < end else "due"


def archived_field(a):
    """{"date", "orig", "hd", "snapshot", "size", "files"} of an archived project, or None."""
    if isinstance(a, dict) and a.get("hd") and a.get("orig"):
        return a
    return None


def untrash(r):
    """A stage to restore to: trash itself is not one (falls back to hold)."""
    return 0 if r == TRASH else r


def load(path=None):
    global IDS_ADDED
    try:
        with open(path or DATA_FILE, encoding="utf-8") as f:
            items = json.load(f)
    except (OSError, ValueError):
        return []
    out = []
    for it in items:
        if not it.get("id"):
            IDS_ADDED = True
        out.append({
            "id": str(it.get("id") or new_id()),       # stable key (descriptions may repeat)
            "desc": str(it.get("desc", "")),
            "rank": stage_of(it.get("stage"), it.get("rank"), 0),
            # stage before trashing: a name now; a legacy number only in old-format entries
            "prev": untrash(stage_of(it.get("prev"), None if "stage" in it else it.get("prev"), 0)),
            "member": str(it.get("member", "")),
            "path": str(it.get("path", "")),
            "obs": str(it.get("obs", "")),
            "mod": str(it.get("mod", "")),   # YYYY-MM-DD, "" = unknown
            "claude": str(it.get("claude", "")),   # owned by Claude Code, read-only here
            "job": job_field(it.get("job")),       # owned by Claude Code, read-only here
            "archived": archived_field(it.get("archived")),   # set by A (projman-archive)
        })
    return out


def purge(items):
    """Drop trash older than TRASH_DAYS. Returns (kept, n_purged, changed)."""
    keep, n, changed = [], 0, False
    for it in items:
        if it["rank"] == TRASH:
            try:
                age = (datetime.date.today() - datetime.date.fromisoformat(it["mod"])).days
            except ValueError:
                it["mod"], changed = datetime.date.today().isoformat(), True   # start its clock
                age = 0
            if age >= TRASH_DAYS:
                n += 1
                continue
        keep.append(it)
    return keep, n, changed


BACKUP_FILE = DATA_FILE + ".bak"
CD_FILE = os.environ.get("PROJMAN_CDFILE", "")          # set by the bash wrapper
TERMINAL = os.environ.get("PROJMAN_TERMINAL", "alacritty")
CLAUDE_CMD = "claude --continue || claude; exec bash"
CLAUDE_RESUME_CMD = "claude --resume; exec bash"
ARCHIVER = os.environ.get("PROJMAN_ARCHIVER", "projman-archive")


def proj_dir(it):
    """(existing directory or None, expanded path text) for a project's PATH."""
    p = os.path.expanduser(it["path"].strip()) if it["path"].strip() else ""
    return (p if p and os.path.isdir(p) else None), p


def open_terminal(d, cmd=None):
    args = [TERMINAL, "--working-directory", d] + (["-e", "bash", "-c", cmd] if cmd else [])
    subprocess.Popen(args, cwd=d, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def human(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or u == "TB":
            return f"{n:.1f} {u}" if u != "B" else f"{n} B"
        n /= 1024


def run_archiver(stdscr, it):
    """Leave curses, run projman-archive (archive or restore) in the terminal, come back.
    Returns (record written by the script or None, message for the flash line)."""
    a = it.get("archived")
    fd, res = tempfile.mkstemp(prefix="projman-archive-", suffix=".json")
    os.close(fd)
    if a:
        cmd = [ARCHIVER, "restore", a["orig"], "--hd", a["hd"],
               "--snapshot", a.get("snapshot", ""), "--id", it["id"], "--result", res]
    else:
        cmd = [ARCHIVER, "archive", it["path"].strip(), "--id", it["id"], "--result", res]
    curses.def_prog_mode()
    curses.endwin()
    msg = ""
    try:
        print(f"\n{it['desc']}\n")
        try:
            proc = subprocess.Popen(cmd)
        except OSError as e:
            msg = f"could not start {ARCHIVER}: {e}"
            proc = None
        while proc is not None:
            try:
                rc = proc.wait()
                break
            except KeyboardInterrupt:       # Ctrl-C belongs to the script; wait for it
                continue
        try:
            input("\n[Enter] back to projman ")
        except (KeyboardInterrupt, EOFError):
            pass
    finally:
        curses.reset_prog_mode()
        stdscr.clear()
        stdscr.refresh()
    rec = None
    try:
        with open(res, encoding="utf-8") as f:
            rec = json.load(f)
    except (OSError, ValueError):
        pass
    finally:
        try:
            os.remove(res)
        except OSError:
            pass
    if not msg:
        msg = ("restored" if a else "archived") if rec else \
            f"{'restore' if a else 'archive'} not done (exit {rc}); nothing changed"
    return rec, msg


def merge_claude(items):
    """Copy the "claude" and "job" fields from the file on disk into items (Claude Code is
    their only writer, so the disk copy is always the newest). Match by id, else by (desc, path)."""
    try:
        with open(DATA_FILE, encoding="utf-8") as f:
            disk = json.load(f)
    except (OSError, ValueError):
        return
    by_id, by_key = {}, {}
    for d in disk:
        v = (d.get("claude", ""), job_field(d.get("job")))
        if d.get("id"):
            by_id[d["id"]] = v
        k = (d.get("desc", ""), d.get("path", ""))
        by_key[k] = None if k in by_key else v
    for it in items:
        v = by_id.get(it["id"]) or by_key.get((it["desc"], it["path"]))
        if v is not None:
            it["claude"], it["job"] = v


def save(items):
    """Write atomically; the previous version is kept as <file>.bak (one-step undo)."""
    merge_claude(items)
    if os.path.exists(DATA_FILE):
        try:
            shutil.copy2(DATA_FILE, BACKUP_FILE)
        except OSError:
            pass
    d = os.path.dirname(os.path.abspath(DATA_FILE))
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".projman-")
    out = []
    for it in items:   # stages go to disk by name ("rank" is the in-memory number only)
        d = {k: v for k, v in it.items()
             if k not in ("rank", "prev") and not (k == "archived" and v is None)}
        d["stage"], d["prev"] = sname(it["rank"]), sname(it["prev"])
        out.append(d)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.replace(tmp, DATA_FILE)


# ---------------------------------------------------------------- helpers
def fold(s):
    """Lower-case and strip accents, for forgiving searches."""
    s = unicodedata.normalize("NFKD", s.casefold())
    return "".join(c for c in s if not unicodedata.combining(c))


def matches(it, query):
    hay = fold(" ".join((it["desc"], it["member"], it["path"], it["obs"], it["claude"],
                         (it.get("job") or {}).get("what", ""),
                         sname(it["rank"]), "archived" if it.get("archived") else "")))
    return all(tok in hay for tok in fold(query).split())


def prompt(stdscr, col, label, text=""):
    """One-line input on the bottom-but-one row. Enter = ok, Esc = cancel."""
    H, W = stdscr.getmaxyx()
    y = H - 2
    while True:
        put(stdscr, y, 0, " " * (W - 1))
        put(stdscr, y, 1, label, col.bright() | curses.A_BOLD)
        shown = text[-(W - len(label) - 4):]
        put(stdscr, y, 2 + len(label), shown, col.bright())
        try:
            curses.curs_set(1)
            stdscr.move(y, min(W - 2, 2 + len(label) + len(shown)))
        except curses.error:
            pass
        stdscr.refresh()
        k = stdscr.get_wch()
        if k in ("\n", "\r", curses.KEY_ENTER):
            return text
        if k in ("\x1b", "\x03"):
            return None
        if k in ("\x7f", "\b", curses.KEY_BACKSPACE):
            text = text[:-1]
        elif k == "\x15":
            text = ""
        elif isinstance(k, str) and k.isprintable():
            text += k


def today():
    return datetime.date.today().isoformat()


def age_text(iso):
    """'2026-11-17  3d' style text for the LAST MODIFIED column."""
    try:
        d = datetime.date.fromisoformat(iso)
    except ValueError:
        return "—"
    n = (datetime.date.today() - d).days
    if n <= 0:
        a = "today"
    elif n < 14:
        a = f"{n}d"
    elif n < 63:
        a = f"{n // 7}w"
    elif n < 365:
        a = f"{n // 30}mo"
    else:
        a = f"{n // 365}y"
    return f"{iso}  {a}"

def clip(s, w):
    s = s.replace("\n", " ")
    if w <= 0:
        return ""
    return s if len(s) <= w else s[: max(0, w - 1)] + "…"


def clip_left(s, w):
    """Like clip() but keeps the END of the text (the interesting part of a path)."""
    if w <= 0:
        return ""
    return s if len(s) <= w else "…" + s[-(w - 1):] if w > 1 else "…"


def put(win, y, x, s, attr=0):
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass


class Colors:
    def __init__(self):
        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        rich = curses.COLORS >= 256
        self.rich = rich
        for i, (_, c256, c8) in enumerate(STAGES, start=1):   # pair i = stage i-1
            fg = c256 if rich else c8
            curses.init_pair(i, fg, -1)                      # normal text
            curses.init_pair(20 + i, fg, SEL_BG if rich else -1)  # selected row
            curses.init_pair(40 + i, 16 if rich else curses.COLOR_BLACK, fg)  # badge
        curses.init_pair(19, 242 if rich else curses.COLOR_WHITE, -1)          # trash
        curses.init_pair(39, 248 if rich else curses.COLOR_WHITE, SEL_BG if rich else -1)
        curses.init_pair(59, 16 if rich else curses.COLOR_BLACK, 242 if rich else curses.COLOR_WHITE)
        curses.init_pair(60, 245 if rich else curses.COLOR_WHITE, -1)          # dim
        curses.init_pair(61, 245 if rich else curses.COLOR_WHITE, SEL_BG if rich else -1)
        curses.init_pair(62, 252 if rich else curses.COLOR_WHITE, -1)          # bright
        curses.init_pair(63, 252 if rich else curses.COLOR_WHITE, SEL_BG if rich else -1)

    @staticmethod
    def _pair(rank):
        """Colour-pair offset: stage r uses pairs r+1, 20+r+1, 40+r+1; trash uses 19, 39, 59."""
        return 19 if rank == TRASH else rank + 1

    def text(self, rank, sel=False):
        a = curses.color_pair((20 if sel else 0) + self._pair(rank))
        if rank == TRASH and not self.rich:
            a |= curses.A_DIM
        return a | (curses.A_BOLD if sel else 0)

    def badge(self, rank):
        return curses.color_pair(40 + self._pair(rank)) | curses.A_BOLD

    def dim(self, sel=False):
        return curses.color_pair(61 if sel else 60)

    def bright(self, sel=False):
        return curses.color_pair(63 if sel else 62)


# ---------------------------------------------------------------- form
def form(stdscr, col, title, item):
    """Modal editor. Returns edited dict or None if cancelled."""
    H, W = stdscr.getmaxyx()
    bw, bh = min(W - 2, 78), 15
    win = curses.newwin(bh, bw, max(0, (H - bh) // 2), max(0, (W - bw) // 2))
    win.keypad(True)
    labels = [("Description", "desc"), ("Maturity", "rank"),
              ("Team", "member"), ("Path", "path"), ("OBS", "obs")]
    vals = dict(item)
    pos = {k: len(vals[k]) for k in ("desc", "member", "path", "obs")}
    f = 0
    fx = 17
    fw = bw - fx - 3
    while True:
        win.erase()
        win.box()
        put(win, 0, 3, f" {title} ", curses.A_BOLD)
        cy = cx = None
        for i, (lab, key) in enumerate(labels):
            y = 2 + i * 2
            put(win, y, 3, lab, col.bright() | (curses.A_BOLD if i == f else 0))
            if key == "rank":
                r = vals["rank"]
                put(win, y, fx, f" {blabel(r)} ", col.badge(r))
                put(win, y, fx + 4, sname(r), col.text(r) | curses.A_BOLD)
                if i == f:
                    put(win, y, fx + 18, f"← →  or 0-{N - 1}  (← below 0 = trash)", col.dim())
            else:
                text, p = vals[key], pos[key]
                start = max(0, p - fw + 1)
                shown = text[start:start + fw]
                attr = curses.A_UNDERLINE | (curses.A_BOLD if i == f else 0)
                put(win, y, fx, shown.ljust(fw), attr)
                if i == f:
                    cy, cx = y, fx + p - start
        put(win, bh - 2, 3,
            "Tab/↑↓ field · Enter next/save · Ctrl-S save · Esc cancel", col.dim())
        try:
            curses.curs_set(0 if cy is None else 1)
        except curses.error:
            pass
        if cy is not None:
            win.move(cy, cx)
        win.refresh()

        try:
            k = win.get_wch()
        except KeyboardInterrupt:
            return None
        key = labels[f][1]

        if k in ("\x1b", "\x03"):
            return None
        if k in ("\x13",) or (k in ("\n", "\r", curses.KEY_ENTER) and f == len(labels) - 1):
            if not vals["desc"].strip():
                f = 0
                continue
            return vals
        if k in ("\t", curses.KEY_DOWN, "\n", "\r", curses.KEY_ENTER):
            f = (f + 1) % len(labels)
        elif k in (curses.KEY_BTAB, curses.KEY_UP):
            f = (f - 1) % len(labels)
        elif key == "rank":
            if k in (curses.KEY_RIGHT, "+", "l"):
                vals["rank"] = min(N - 1, vals["rank"] + 1)
            elif k in (curses.KEY_LEFT, "-", "h"):
                vals["rank"] = max(TRASH, vals["rank"] - 1)
            elif isinstance(k, str) and len(k) == 1 and k in "0123456789"[:N]:
                vals["rank"] = int(k)
        else:
            t, p = vals[key], pos[key]
            if k == curses.KEY_LEFT:
                pos[key] = max(0, p - 1)
            elif k == curses.KEY_RIGHT:
                pos[key] = min(len(t), p + 1)
            elif k in (curses.KEY_HOME, "\x01"):
                pos[key] = 0
            elif k in (curses.KEY_END, "\x05"):
                pos[key] = len(t)
            elif k in ("\x7f", "\b", curses.KEY_BACKSPACE):
                if p > 0:
                    vals[key] = t[:p - 1] + t[p:]
                    pos[key] = p - 1
            elif k == curses.KEY_DC:
                vals[key] = t[:p] + t[p + 1:]
            elif k == "\x15":  # Ctrl-U: clear
                vals[key], pos[key] = "", 0
            elif isinstance(k, str) and k.isprintable():
                vals[key] = t[:p] + k + t[p:]
                pos[key] = p + 1


# ---------------------------------------------------------------- main UI
def run(stdscr):
    locale.setlocale(locale.LC_ALL, "")
    curses.curs_set(0)
    curses.raw()  # no XON/XOFF: Ctrl-S must not freeze the terminal
    stdscr.keypad(True)
    col = Colors()
    items = load()
    sel = items[0] if items else None
    descending = False
    by_age = False   # False: by maturity · True: oldest-touched first
    query = ""       # active filter ("/" to set, Esc to clear)
    view_trash = False
    show_finished = False   # finished projects are hidden until p
    hint = None      # row to select if the selected one leaves the view
    top = 0
    flash = ""
    items[:], n_purged, changed = purge(items)
    if n_purged or changed or IDS_ADDED:
        save(items)
    if n_purged:
        flash = f"purged {n_purged} project(s) trashed more than {TRASH_MONTHS} months ago"

    def detail(it, width):
        """Lines (text, attr) of the detail box: name, stage + date, team, path, OBS, Claude."""
        r = it["rank"]
        out = [(it["desc"] or "—", col.bright() | curses.A_BOLD)]
        if r == TRASH:
            try:
                left = TRASH_DAYS - (datetime.date.today()
                                     - datetime.date.fromisoformat(it["mod"])).days
            except ValueError:
                left = TRASH_DAYS
            out.append((f"trash · trashed {it['mod'] or '—'} · {max(0, left)}d left", col.text(TRASH)))
        else:
            out.append((f"{sname(r)} · modified {age_text(it['mod'])}", col.text(r) | curses.A_BOLD))
        out.append((f"team  {it['member'] or '—'}", col.bright() if it["member"] else col.dim()))
        p = it["path"].strip()
        if p:
            home, ap = os.path.expanduser("~"), os.path.expanduser(p)
            if ap == home or ap.startswith(home + os.sep):
                p = "~" + ap[len(home):]
        out.append(("path  " + clip_left(p, width - 6), col.bright()))
        a = it.get("archived")
        if a:
            hd_ok = os.path.isdir(a["hd"])
            out.append((f"arch  {a.get('date', '?')} · restic {str(a.get('snapshot', ''))[:8]} · "
                        f"{human(a.get('size', 0))}" + ("" if hd_ok else " · HD not mounted"),
                        col.text(r) | curses.A_BOLD))
            out.append(("was   " + clip_left(a["orig"], width - 6), col.dim()))
        if it["obs"].strip():
            out += [("", 0), ("OBS", col.dim() | curses.A_BOLD)]
            for para in it["obs"].splitlines():
                out += [(ln, col.bright()) for ln in (textwrap.wrap(para, width) or [""])]
        js = job_state(it)
        if it["claude"].strip() or js:
            out += [("", 0), ("Claude", col.dim() | curses.A_BOLD)]
            out += [(ln, col.bright()) for ln in textwrap.wrap(it["claude"], width)]
        if js:
            j = it["job"]
            try:
                end = datetime.datetime.fromisoformat(j["until"]).strftime("%d/%m %H:%M")
            except (ValueError, TypeError):
                end = j["until"] or "?"
            tail = f" · ends ~{end}" if js == "run" else f" · was due ~{end}, unconfirmed"
            tail = " " + tail[1:].replace(" ", "\xa0")   # "· ends ~DD/MM HH:MM" wraps as one piece
            a = col.bright() if js == "run" else col.dim()
            for ln in textwrap.wrap("job   " + j["what"] + tail, width, subsequent_indent=" " * 6):
                out.append((ln.replace("\xa0", " "), a))
        return out

    def ordered():
        if view_trash:      # soonest-to-be-purged first
            key = lambda i: (i["mod"], i["desc"].lower())
        elif by_age:
            key = lambda i: (i["mod"] or "0000-00-00", i["rank"], i["desc"].lower())
        else:
            key = lambda i: (i["rank"], i["desc"].lower())
        pool = [i for i in items if (i["rank"] == TRASH) == view_trash
                and (view_trash or show_finished or i["rank"] != FINISHED)]
        shown = [i for i in pool if matches(i, query)] if query else pool
        return sorted(shown, key=key, reverse=descending)

    while True:
        rows = ordered()
        if sel not in rows:
            sel = hint if hint in rows else (rows[0] if rows else None)
        idx = rows.index(sel) if sel is not None else 0
        hint = (rows[idx + 1] if idx + 1 < len(rows) else rows[idx - 1] if idx else None) if rows else None
        H, W = stdscr.getmaxyx()
        # layout: list block (# STAGE PROJECT TEAM) + detail box of the selected project,
        # beside the list when at least ~40 columns remain, otherwise below it
        wst = 12
        wi = max(2, len(str(len(rows))))
        wd = max(14, min(40, max((len(i["desc"]) for i in items), default=0)))
        wm = max(6, min(30, max((len(i["member"]) for i in items), default=0)))
        xi = 1
        xst = xi + wi + 1
        xdot = xst + wst + 1                  # job: "•" running, "◦" expected end passed
        xd = xdot + 2
        side = W - (xd + wd + 1 + wm + 1) >= 42
        if not side:                          # narrow: shrink PROJECT, then TEAM, to fit
            avail = W - xd - 2
            if wd + 1 + wm > avail:
                wd = max(8, avail - 1 - wm)
                wm = max(4, avail - 1 - wd)
        xm = xd + wd + 1
        lw = xm + wm + 1                      # width of the list block
        list_top = 3
        if side:
            list_bot = H - 4                  # visible rows: [list_top, list_bot)
            bx, by, bw, bh = lw + 2, 2, W - lw - 3, H - 4 - 2
        else:
            list_bot = list_top + max(3, (H - 7) // 2)
            bx, by, bw, bh = 1, list_bot + 1, W - 2, H - 4 - (list_bot + 1)
        vis = max(1, list_bot - list_top)
        top = max(0, min(top, max(0, len(rows) - vis)))
        if idx < top:
            top = idx
        if idx >= top + vis:
            top = idx - vis + 1

        stdscr.erase()
        # title + stage legend with counts
        put(stdscr, 0, 1, "projman", col.bright() | curses.A_BOLD)
        if view_trash:
            put(stdscr, 0, 10, f" {blabel(TRASH)} ", col.badge(TRASH))
            put(stdscr, 0, 13, " trash", col.text(TRASH) | curses.A_BOLD)
            put(stdscr, 0, 21, clip(
                f"permanently deleted {TRASH_MONTHS} months after trashing", W - 22), col.dim())
        else:
            full = sum(3 + len(f" {STAGES[r][0]}") + 2 for r in range(N))
            named = 10 + full <= W
            x = 10
            for r in range(N):
                tail = f" {STAGES[r][0]}" if named else ""
                if x + 3 + len(tail) >= W:
                    break
                put(stdscr, 0, x, f" {blabel(r)} ", col.badge(r))
                put(stdscr, 0, x + 3, tail, col.text(r))
                x += 3 + len(tail) + 2

        hdr = col.dim() | curses.A_BOLD
        put(stdscr, 2, xi, "#".rjust(wi), hdr)
        put(stdscr, 2, xst, "STAGE", hdr)
        put(stdscr, 2, xd, "PROJECT", hdr)
        put(stdscr, 2, xm, "TEAM", hdr)
        put(stdscr, 1, 0, "─" * (W - 1), col.dim())
        n_trash = sum(1 for i in items if i["rank"] == TRASH)
        n_fin = sum(1 for i in items if i["rank"] == FINISHED)
        if not view_trash:
            lab = (f" finished: {n_fin} {'shown' if show_finished else 'hidden'} (p) " if n_fin else "") \
                + (f" trash: {n_trash}  (t) " if n_trash else "")
            if lab:
                put(stdscr, 1, W - len(lab) - 2, lab, col.dim())
        if query:
            put(stdscr, 1, 2, clip(f" filter: {query}  ({len(rows)}/{len(items)})  Esc clears ", W - 4),
                col.bright() | curses.A_BOLD)

        if not rows:
            put(stdscr, 5, 3, "No match — Esc clears the filter." if query
                else "Trash is empty." if view_trash
                else "No projects yet — press  a  to add one.", col.dim())
        for n, it in enumerate(rows[top:top + vis]):
            y = list_top + n
            is_sel = it is sel
            r = it["rank"]
            t = col.text(r, is_sel)
            if is_sel:
                put(stdscr, y, 0, " " * lw, t)
                put(stdscr, y, 0, "▌", t)
            put(stdscr, y, xi, str(top + n + 1).rjust(wi), col.dim(is_sel))
            label = "archived" if it.get("archived") else sname(r)
            put(stdscr, y, xst, clip(label, wst).ljust(wst), t | curses.A_BOLD)
            js = job_state(it)
            if js == "run":
                put(stdscr, y, xdot, "•", col.bright(is_sel) | curses.A_BOLD)
            elif js == "due":
                put(stdscr, y, xdot, "◦", col.dim(is_sel))
            put(stdscr, y, xd, clip(it["desc"], wd).ljust(wd),
                col.bright(is_sel) | curses.A_BOLD)
            put(stdscr, y, xm, clip(it["member"] or "—", wm).ljust(wm),
                col.bright(is_sel) if it["member"] else col.dim(is_sel))
        if len(rows) > vis:
            s = f"{idx+1}/{len(rows)}"
            if lw - len(s) > xm + 5:
                put(stdscr, 2, lw - len(s), s, col.dim())

        # detail box of the selected project
        if side:
            for yy in range(2, H - 3):
                put(stdscr, yy, lw, "│", col.dim())
        else:
            put(stdscr, list_bot, 0, "─" * (W - 1), col.dim())
        if sel is not None and bw > 10 and bh > 0:
            lines = detail(sel, bw)
            for n, (s, a) in enumerate(lines[:bh]):
                if n == bh - 1 and len(lines) > bh:
                    s = clip(s, bw - 1) + "…" if len(s) < bw else clip(s, bw)
                put(stdscr, by + n, bx, clip(s, bw), a)

        put(stdscr, H - 3, 0, "─" * (W - 1), col.dim())
        if flash:
            put(stdscr, H - 2, 1, flash, col.dim())
        if view_trash:
            keys = (f"↑↓/jk move · r restore · 0-{N - 1} move to stage · d delete forever · "
                    "u undo · / filter · t/Esc back · q quit")
        else:
            keys = ("↑↓/jk move · Enter edit · g go · o terminal · c/C claude continue/resume · a add · "
                    f"0-{N - 1} maturity ({N - 1} finished) · p show finished · A archive · d trash · u undo · "
                    "/ filter · s flip · m age · t trash · q quit")
        put(stdscr, H - 1, 1, clip(keys, W - 2), col.dim())
        stdscr.refresh()
        flash = ""

        curses.curs_set(0)
        try:
            k = stdscr.get_wch()
        except KeyboardInterrupt:
            break
        if k in ("q", "Q", "\x03"):
            break
        elif k in (curses.KEY_DOWN, "j") and rows:
            sel = rows[min(len(rows) - 1, idx + 1)]
        elif k in (curses.KEY_UP, "k") and rows:
            sel = rows[max(0, idx - 1)]
        elif k == curses.KEY_NPAGE and rows:
            sel = rows[min(len(rows) - 1, idx + vis)]
        elif k == curses.KEY_PPAGE and rows:
            sel = rows[max(0, idx - vis)]
        elif k == curses.KEY_HOME and rows:
            sel = rows[0]
        elif k in (curses.KEY_END, "G") and rows:
            sel = rows[-1]
        elif k == "s":
            descending = not descending
        elif k == "m":
            by_age = not by_age
        elif k == "/":
            q = prompt(stdscr, col, "filter:", query)
            if q is not None:
                query = q.strip()
        elif k == "\x1b" and query:
            query = ""
        elif k == "\x1b" and view_trash:
            view_trash, sel = False, None
        elif k == "t":
            view_trash, query, sel = not view_trash, "", None
        elif k == "p" and not view_trash:
            show_finished = not show_finished
            flash = "finished projects shown" if show_finished else "finished projects hidden"
        elif k == "u":
            prev = load(BACKUP_FILE)
            if os.path.exists(BACKUP_FILE):
                old_desc = sel["desc"] if sel else None
                items[:] = prev
                save(items)          # current state becomes the new .bak → u again = redo
                sel = next((i for i in items if i["desc"] == old_desc), None)
                flash = "undone (press u again to redo)"
        elif k == "a":
            new = form(stdscr, col, "New project",
                       {"id": new_id(), "desc": "", "rank": 0, "prev": 0, "member": "",
                        "path": "", "obs": "", "mod": "", "claude": "", "job": None})
            if new:
                new["mod"] = today()
                if new["rank"] == TRASH:
                    new["prev"] = 0
                items.append(new)
                query, view_trash = "", new["rank"] == TRASH
                if new["rank"] == FINISHED:
                    show_finished = True
                sel = new
                save(items)
        elif k in ("g", "o", "c", "C") and sel is not None:
            d, p = proj_dir(sel)
            if not p:
                flash = "no PATH set for this project"
            elif not d and sel.get("archived"):
                flash = f"archived on the external HD, which is not mounted: {p}"
            elif not d:
                flash = f"PATH not found on this machine: {p}"
            elif k == "o":
                try:
                    open_terminal(d)
                    flash = f"opened a terminal in {p}"
                except OSError as e:
                    flash = f"could not start {TERMINAL}: {e}"
            elif k in ("c", "C"):
                try:
                    open_terminal(d, CLAUDE_CMD if k == "c" else CLAUDE_RESUME_CMD)
                    time.sleep(0.1)               # let claude's window map first
                    open_terminal(d)
                except OSError as e:
                    flash = f"could not start {TERMINAL}: {e}"
                    continue
                if CD_FILE:                       # ask the wrapper to close this shell
                    with open(CD_FILE, "w", encoding="utf-8") as f:
                        f.write("exit")
                break
            elif not CD_FILE:
                flash = f"g needs the bash wrapper `projman` to cd · path: {p}"
            else:
                with open(CD_FILE, "w", encoding="utf-8") as f:
                    f.write("cd " + d)
                break
        elif k in ("\n", "\r", curses.KEY_ENTER) and sel is not None:
            new = form(stdscr, col, "Edit project", sel)
            if new:
                changed = any(new[f] != sel[f] for f in ("desc", "rank", "member", "path", "obs"))
                if changed and not (sel["rank"] == TRASH and new["rank"] == TRASH):  # editing trash keeps its clock
                    new["mod"] = today()
                if new["rank"] == TRASH and sel["rank"] != TRASH:
                    new["prev"] = sel["rank"]
                if sel.get("archived") and (new["rank"] != sel["rank"] or new["path"] != sel["path"]):
                    new["rank"], new["path"] = sel["rank"], sel["path"]
                    flash = "archived: stage and PATH stay as they are (A restores the project)"
                if new["rank"] == FINISHED and sel["rank"] != FINISHED and not show_finished:
                    flash = "finished: hidden from the list (p shows finished)"
                sel.update(new)
                save(items)
        elif isinstance(k, str) and len(k) == 1 and k in "0123456789"[:N] and sel is not None:
            r = int(k)
            if sel.get("archived") and r != sel["rank"]:
                flash = "archived: restore it first (A)"
            elif sel["rank"] != r:
                sel["rank"], sel["mod"] = r, today()
                if r == FINISHED and not show_finished and not view_trash:
                    flash = "finished: hidden from the list (p shows finished · u to undo)"
                save(items)
        elif k == "A" and sel is not None and not view_trash:
            d, p = proj_dir(sel)
            if not sel.get("archived") and sel["rank"] != FINISHED:
                flash = "only finished projects are archived (9 marks finished)"
            elif not sel.get("archived") and not d:
                flash = f"PATH not found on this machine: {p}" if p else "no PATH set for this project"
            else:
                rec, flash = run_archiver(stdscr, sel)
                if rec and sel.get("archived"):
                    sel["path"], sel["archived"], sel["mod"] = sel["archived"]["orig"], None, today()
                    save(items)
                elif rec:
                    sel["path"], sel["archived"], sel["mod"] = rec["hd"], rec, today()
                    save(items)
        elif k == "r" and view_trash and sel is not None:
            sel["rank"], sel["mod"] = sel["prev"], today()
            flash = f"restored to {sname(sel['rank'])}"
            save(items)
        elif k == "d" and sel is not None and not view_trash and sel.get("archived"):
            flash = "archived projects are not trashed: restore first (A)"
        elif k == "d" and sel is not None and not view_trash:
            sel["prev"], sel["rank"], sel["mod"] = sel["rank"], TRASH, today()
            flash = "moved to trash (t to view · u to undo)"
            save(items)
        elif k == "d" and sel is not None:
            put(stdscr, H - 2, 1, " " * (W - 2))
            put(stdscr, H - 2, 1, f"Delete forever “{clip(sel['desc'], 40)}”? (y/N)",
                col.bright() | curses.A_BOLD)
            stdscr.refresh()
            if stdscr.get_wch() in ("y", "Y"):
                items.remove(sel)
                sel = hint
                save(items)
        elif k == curses.KEY_RESIZE:
            pass


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return
    curses.wrapper(run)


if __name__ == "__main__":
    main()
