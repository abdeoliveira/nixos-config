#!/usr/bin/env python3
"""Write Claude Code's project status into ~/.projman.json ("claude" and "job" fields).

Installed by ~/.nixos-config as `projman-claude` (in PATH, via my-scripts) and linked to
~/.claude/bin/projman_claude.py (home.file), the path Claude Code is told to use.

    projman_claude.py set "<status>" [--dir DIR]   set the status of the project owning DIR
    projman_claude.py get [--dir DIR]              print the current status
    projman_claude.py list                         all projects with a path, and their status
    projman_claude.py job set "<what>" --until END [--dir DIR]
                                                   mark a running job (projman shows a dot)
    projman_claude.py job clear [--dir DIR]        the job finished (confirmed): remove the mark
    projman_claude.py job get [--dir DIR]          print the current job

END is the expected end: "YYYY-MM-DD HH:MM", "DD/MM HH:MM", "HH:MM" (today, or tomorrow if
already past) or "+12h" / "+90m" / "+1h30m". projman shows "•" until END and a hollow "◦"
after it, until the job is cleared.

The project is the entry whose "path" contains DIR (default: current directory), longest
match wins. Entries without a path are never touched. Only the "claude" field (and a
missing "id") is written; every other field, the key order and the .bak undo file used by
projman are left as they are. The date (DD/MM) is prefixed automatically to the status.
"""
import json, os, re, sys, tempfile, datetime, uuid

FILE = os.environ.get("PROJMAN_FILE", os.path.expanduser("~/.projman.json"))
MAXLEN = 90


def norm(p):
    return os.path.realpath(os.path.expanduser(p)) if p else ""


def load():
    with open(FILE, encoding="utf-8") as f:
        return json.load(f)


def find(items, d):
    d = norm(d)
    best, blen, tie = None, -1, False
    for it in items:
        p = norm(it.get("path", ""))
        if p and (d == p or d.startswith(p + os.sep)):
            if len(p) > blen:
                best, blen, tie = it, len(p), False
            elif len(p) == blen:
                tie = True
    if tie:
        sys.exit(f"projman_claude: two projects share the path of {d}; not writing")
    return best


def write(items):
    d = os.path.dirname(os.path.abspath(FILE))
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".projman-claude-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, os.stat(FILE).st_mode & 0o777)
    os.replace(tmp, FILE)


def parse_until(s):
    """Expected end -> "YYYY-MM-DDTHH:MM" (local time)."""
    now = datetime.datetime.now().replace(second=0, microsecond=0)
    s = s.strip()
    m = re.fullmatch(r"\+(?:(\d+)h)?(?:(\d+)m)?", s)
    if m and (m.group(1) or m.group(2)):
        end = now + datetime.timedelta(hours=int(m.group(1) or 0), minutes=int(m.group(2) or 0))
    elif re.fullmatch(r"\d{4}-\d{2}-\d{2}[ T]\d{1,2}:\d{2}", s):
        end = datetime.datetime.fromisoformat(s.replace(" ", "T"))
    elif re.fullmatch(r"\d{1,2}/\d{1,2} \d{1,2}:\d{2}", s):
        dm, hm = s.split()
        dd, mm = map(int, dm.split("/")); h, mi = map(int, hm.split(":"))
        end = now.replace(month=mm, day=dd, hour=h, minute=mi)
    elif re.fullmatch(r"\d{1,2}:\d{2}", s):
        h, mi = map(int, s.split(":"))
        end = now.replace(hour=h, minute=mi)
        if end <= now:
            end += datetime.timedelta(days=1)
    else:
        sys.exit(f"projman_claude: cannot read --until {s!r}")
    return end.strftime("%Y-%m-%dT%H:%M")


def main():
    a = sys.argv[1:]
    d = os.getcwd()
    if "--dir" in a:
        i = a.index("--dir"); d = a[i + 1]; del a[i:i + 2]
    until = None
    if "--until" in a:
        i = a.index("--until"); until = a[i + 1]; del a[i:i + 2]
    if not a or a[0] not in ("set", "get", "list", "job") or (a[0] == "job" and (len(a) < 2 or a[1] not in ("set", "clear", "get"))):
        sys.exit(__doc__)
    items = load()
    if a[0] == "list":
        for it in items:
            if it.get("path"):
                j = it.get("job") or {}
                job = f"  [job: {j.get('what', '')} until {j.get('until', '')}]" if j else ""
                print(f"{it.get('desc', '')[:30]:30s}  {it['path'][:40]:40s}  {it.get('claude', '')}{job}")
        return
    it = find(items, d)
    if it is None:
        print(f"projman_claude: no project path contains {norm(d)}; nothing written")
        sys.exit(2)
    if a[0] == "get":
        print(f"{it.get('desc', '')}: {it.get('claude', '') or '(empty)'}")
        return
    if a[0] == "job":
        if a[1] == "get":
            j = it.get("job")
            print(f"{it.get('desc', '')}: " + (f"{j['what']} (until {j.get('until', '?')})" if j else "(no job)"))
            return
        if a[1] == "clear":
            had = it.pop("job", None)
            write(items)
            print(f"{it.get('desc', '')}: job cleared" + ("" if had else " (there was none)"))
            return
        what = " ".join(a[2:]).strip().replace("\n", " ")
        if not what or not until:
            sys.exit("projman_claude: job set needs a description and --until END")
        for x in items:
            if not x.get("id"):
                x["id"] = uuid.uuid4().hex[:8]
        it["job"] = {"what": what[:MAXLEN], "until": parse_until(until)}
        write(items)
        print(f"{it.get('desc', '')}: job {it['job']['what']} until {it['job']['until']}")
        return
    text = " ".join(a[1:]).strip().replace("\n", " ")
    if not text:
        sys.exit("projman_claude: empty status")
    status = f"{datetime.date.today():%d/%m} {text}"
    if len(status) > MAXLEN:
        status = status[:MAXLEN - 1] + "…"
    for x in items:                     # projman matches by id: give every entry one
        if not x.get("id"):
            x["id"] = uuid.uuid4().hex[:8]
    it["claude"] = status
    write(items)
    print(f"{it.get('desc', '')}: {status}")


if __name__ == "__main__":
    main()
